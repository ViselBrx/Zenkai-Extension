  "tokenColors": [
    { "name": "Comments", "scope": ["comment"], "settings": { "foreground": "#527661", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "storage"], "settings": { "foreground": "#D42426", "fontStyle": "bold" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#F4C95D" } },
    { "name": "Variables", "scope": ["variable"], "settings": { "foreground": "#F7EEE2" } },
    { "name": "Properties", "scope": ["variable.other.property", "meta.property-name"], "settings": { "foreground": "#8ED1A4" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#F4C95D", "fontStyle": "bold" } },
    { "name": "Classes and Types", "scope": ["entity.name.class", "entity.name.type", "support.type"], "settings": { "foreground": "#FF9A9B" } },
    { "name": "Strings", "scope": ["string"], "settings": { "foreground": "#76C893" } },
    { "name": "Numbers and Constants", "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#F4C95D" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#D42426" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8ED1A4" } }
  ]
}
