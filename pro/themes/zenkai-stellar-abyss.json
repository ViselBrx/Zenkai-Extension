  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#4A5A7A", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#A6CCFF" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#FF6B8A" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": { "foreground": "#C8D6E8" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.property-name", "support.type.property-name"],
      "settings": { "foreground": "#8DD8FF" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "meta.function-call", "support.function"],
      "settings": { "foreground": "#C084FC", "fontStyle": "bold" }
    },
    {
      "name": "Classes / Types",
      "scope": ["entity.name.class", "entity.name.type.class", "support.class", "support.type"],
      "settings": { "foreground": "#FFD194" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#7BFFCF" }
    },
    {
      "name": "Numbers / Booleans",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#FF6B8A" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#7B8FFF" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#C084FC" }
    }
  ]
}

