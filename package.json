{
    "name": "zenkai-vscode-extension",
    "displayName": "Zenkai Theme",
    "description": "A vibrant, neon-infused dark theme ecosystem for VS Code inspired by the Zenkai Universe.",
    "version": "0.0.7",
    "icon": "assets/icon.png",
    "main": "./out/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Themes"
    ],
    "publisher": "zenkai",
    "repository": {
        "type": "git",
        "url": "https://github.com/ViselBrx/Zenkai-VSCode-Extension"
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "contributes": {
        "commands": [
            {
                "command": "zenkaiTheme.activateLicense",
                "title": "Zenkai: Activate Pro License Key"
            },
            {
                "command": "zenkaiTheme.checkLicense",
                "title": "Zenkai: Check License Status"
            }
        ],
        "configuration": {
            "title": "Zenkai Theme",
            "properties": {
                "zenkaiTheme.licenseKey": {
                    "type": "string",
                    "default": "",
                    "description": "Enter your Zenkai Pro license key",
                    "order": 1
                },
                "zenkaiTheme.proEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Status of Zenkai Pro (managed automatically)",
                    "order": 2
                }
            }
        },
        "themes": [
            {
                "label": "Zenkai Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-color-theme.json"
            },
            {
                "label": "Zenkai Neon Cyan",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-cyan.json"
            },
            {
                "label": "Zenkai Neon Green",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-green.json"
            },
            {
                "label": "Zenkai Neon Yellow",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-yellow.json"
            },
            {
                "label": "Zenkai Neon Red",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-red.json"
            },
            {
                "label": "Zenkai Neon Purple",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-purple.json"
            },
            {
                "label": "Zenkai Neon Orange",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-orange.json"
            },
            {
                "label": "Zenkai Neon Blue",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-blue.json"
            },
            {
                "label": "Zenkai Neon Dark Green",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-dark-green.json"
            },
            {
                "label": "Zenkai Neon White",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-white.json"
            },
            {
                "label": "Zenkai Neon Aqua",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-aqua.json"
            },
            {
                "label": "Zenkai Stellar Abyss",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-stellar-abyss.json"
            },
            {
                "label": "Zenkai Christmas",
                "uiTheme": "vs-dark",
                "path": "./themes/zenkai-christmas.json"
            }
        ]
    },
    "license": "MIT",
    "dependencies": {
        "dodopayments": "^2.48.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.2.2"
    }
}
